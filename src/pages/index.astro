---
import SiteLayout from '../layouts/SiteLayout.astro';
import eventPosts from '../../facebook_image_posts.json';
import { categoryFor, categoryName, simplifyTitle } from '../data/post-categories.js';
const posts = [...eventPosts].sort((a, b) => b.eventDateISO.localeCompare(a.eventDateISO));
const featuredPosts = posts.slice(0, 3);
const heroImage = posts[0]?.images?.[0]?.src || '';
const photoItems = [];
for (const post of featuredPosts) {
  for (const image of post.images || []) {
    if (image?.src && photoItems.length < 5 && !photoItems.some((item) => item.src === image.src)) {
      photoItems.push({ src: image.src, alt: post.title || '香港愛馬女士協會活動' });
    }
  }
}
const dateLabel = (post) => post.eventDate || '活動日期未提供';
---
<SiteLayout title="香港愛馬女士協會 HKALHL｜凝聚愛心，服務社群" description="香港愛馬女士協會凝聚女性馬主與愛馬人士的力量，透過慈善活動服務社群及有需要人士。" active="home">

    <section class="hero" id="home"><div class="hero-image" style={`background-image:url("${heroImage}")`}></div><div class="hero-overlay"></div><div class="container hero-content"><p class="eyebrow light"><span></span> HONG KONG ASSOCIATION OF LADY HORSE LOVERS</p><h1>凝聚愛馬巾幗力量<br><em>關懷社群，傳遞愛心</em></h1><p class="hero-copy">凝聚及發揮女性馬主與愛馬人士的力量，<br class="desktop">透過各類慈善活動服務社群及有需要人士。</p><div class="hero-actions"><a class="button button-gold" href="/about/">認識本會 <span>↗</span></a><a class="button button-outline" href="/news/">探索最新動向 <span>↓</span></a></div></div><div class="hero-note"><span>01</span><i></i><span>慈善同行 · 關愛社區</span></div><div class="hero-scroll">SCROLL TO DISCOVER <span>↓</span></div></section>
    <section class="intro section-pad" id="about"><div class="container intro-grid"><div class="intro-left"><p class="eyebrow"><span></span> ABOUT HKALHL</p><h2>以熱愛馬匹的初心，<br><em>走進社區，關懷每一位。</em></h2><p class="intro-text">香港愛馬女士協會自 2017 年成立，匯聚女性馬主及愛馬人士，將對馬匹的熱愛化為對社會的關懷。我們與社區夥伴同行，推動健康服務、長者關懷與慈善行動。</p><a class="text-link" href="#milestones">認識我們的故事 <span>↗</span></a></div><div class="intro-right"><div class="quote-mark">“</div><p>To promote and mobilize the power of lady horse owners and horse lovers to serve the community and those in need.</p><div class="quote-by"><span></span> OUR PURPOSE</div><div class="since-badge"><strong>2017</strong><span>始於初心<br>服務社群</span></div></div></div><div class="container value-strip"><div><b>01</b><span>創立於 2017 年</span></div><div><b>02</b><span>凝聚女性馬主</span></div><div><b>03</b><span>推動基層健康</span></div><div><b>04</b><span>跨界慈善合作</span></div></div></section>
    <section class="services section-pad" id="services"><div class="container"><div class="section-heading"><div><p class="eyebrow"><span></span> WHAT WE DO</p><h2>以行動，讓關懷走得更遠</h2></div><p>從健康篩查到長者關懷，<br>每一份心意都落實在社區。</p></div><div class="service-grid"><article class="service-card"><div class="service-number">01 <span>健康同行</span></div><div class="service-icon">✳</div><h3>專科義診醫療日</h3><p>聯同專業醫護及合作機構走進社區，提供多元專科諮詢與健康篩查，實踐「早預防、早發現」。</p><a href="/contact/" aria-label="了解專科義診醫療日">了解項目 <span>↗</span></a><div class="card-line"></div></article><article class="service-card featured"><div class="service-number">02 <span>銀齡關懷</span></div><div class="service-icon">♡</div><h3>情暖銀齡</h3><p>透過節慶福袋、社區音樂節與家庭攝影，為長者送上陪伴、歡樂與一份珍藏的溫暖。</p><a href="/contact/" aria-label="了解情暖銀齡">了解項目 <span>↗</span></a><div class="card-line"></div></article><article class="service-card"><div class="service-number">03 <span>公益盛事</span></div><div class="service-icon">✧</div><h3>跨界慈善盛事</h3><p>連結品牌、賽馬及社區力量，舉辦慈善籌款活動，讓善款全數支持有需要的社福機構。</p><a href="/contact/" aria-label="了解慈善盛事">了解項目 <span>↗</span></a><div class="card-line"></div></article></div></div></section>
    <section class="news section-pad" id="news"><div class="container"><div class="section-heading"><div><p class="eyebrow"><span></span> NEWS & STORIES</p><h2>協會動向與社區故事</h2></div><span class="archive-count">協會活動紀錄 · {posts.length} 則</span></div><div class="filters" role="group" aria-label="動向分類"><button class="filter active" data-filter="all">全部動向</button><button class="filter" data-filter="medical">專科義診</button><button class="filter" data-filter="medical-visit">醫診到會</button><button class="filter" data-filter="community">社區關懷</button><button class="filter" data-filter="milestone">重大盛事</button></div><div class="news-grid" id="news-list">{featuredPosts.map((post) => { const category = categoryFor(post); const image = post.images?.[0]?.src || ''; const title = simplifyTitle(post.title); return <article class="news-card" data-category={category}><div class="news-photo"><img src={image} alt={title} loading="lazy" /><span class="news-tag">{categoryName(category)}</span></div><div class="news-copy"><div class="news-meta"><time datetime={post.eventDateISO}>{dateLabel(post)}</time></div><h3>{title}</h3></div></article>; })}</div><p class="archive-note">活動紀錄及相片來自協會 Facebook 專頁。<a href="https://www.facebook.com/hkalhl.org" target="_blank" rel="noreferrer">瀏覽完整專頁 ↗</a></p></div></section>
    <section class="milestones section-pad" id="milestones"><div class="container milestone-grid"><div><p class="eyebrow"><span></span> OUR JOURNEY</p><h2>一路走來，<br><em>步步同行。</em></h2><p class="timeline-intro">從一份關懷社區的初心，走到今天更多元的慈善服務。每個里程碑，都有同行者的支持。</p><a class="text-link" href="/gallery/">重溫活動點滴 <span>↗</span></a></div><div class="timeline"><article><span>2026</span><div><h3>深化社區專科義診</h3><p>於啟德舉辦專科義診醫療日，引入 AI 眼底及心血管健康檢測。</p></div></article><article><span>2025</span><div><h3>醫診到會 · 情暖銀齡</h3><p>巡迴多區社區，舉辦音樂節、長者關懷及家庭攝影活動。</p></div></article><article><span>2018</span><div><h3>慈善服裝展</h3><p>攜手 LUXE Tuxedo 籌得 HK$380,000，全數撥捐三間受惠機構。</p></div></article><article><span>2017</span><div><h3>香港愛馬女士協會成立</h3><p>創會典禮啟程，將愛馬之心帶進社區，展開慈善服務。</p></div></article></div></div></section>
    <section class="join" id="join"><div class="container join-inner"><div><p class="eyebrow light"><span></span> BE PART OF THE GOOD</p><h2>讓關懷，因你而延續。</h2><p>加入我們，一起為社區帶來更多溫暖。</p></div><div class="join-actions"><a href="mailto:ka20180801@gmail.com?subject=會員申請查詢" class="button button-gold">成為會員 <span>↗</span></a><a href="mailto:ka20180801@gmail.com?subject=義工服務查詢" class="button button-outline">加入義工 <span>↗</span></a></div></div><div class="join-decoration">HKALHL</div></section>
  
</SiteLayout>
