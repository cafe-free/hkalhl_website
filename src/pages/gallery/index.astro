---
import SiteLayout from '../../layouts/SiteLayout.astro';
import eventPosts from '../../../facebook_image_posts.json';
import { categoryFor, categoryName, simplifyTitle } from '../../data/post-categories.js';
const posts = [...eventPosts].sort((a, b) => b.eventDateISO.localeCompare(a.eventDateISO));
---
<SiteLayout title="活動回顧｜香港愛馬女士協會 HKALHL" description="重溫香港愛馬女士協會創會、慈善服裝展、義診與長者關懷活動。" active="gallery">
  <section class="page-hero"><div class="container"><p class="eyebrow light"><span></span> GALLERY</p><h1>活動回顧</h1><p>珍藏社區相聚的片刻，重溫同行的點滴。</p></div></section>
  <section class="news section-pad"><div class="container"><div class="filters" role="group" aria-label="動向分類"><button class="filter active" data-filter="all">全部動向</button><button class="filter" data-filter="medical">專科義診</button><button class="filter" data-filter="medical-visit">醫診到會</button><button class="filter" data-filter="elderly">情暖銀齡</button><button class="filter" data-filter="community">社區關懷</button><button class="filter" data-filter="milestone">重大盛事</button></div><div class="news-grid">{posts.map((post) => { const category = categoryFor(post); const image = post.images?.[0]?.src || ''; const title = simplifyTitle(post.title); return <article class="news-card" data-category={category}><div class="news-photo"><img src={image} alt={title} loading="lazy" /><span class="news-tag">{categoryName(category)}</span></div><div class="news-copy"><div class="news-meta"><time datetime={post.eventDateISO}>{post.eventDate || '活動日期未提供'}</time></div><h2>{title}</h2></div></article>; })}</div><p class="archive-note">活動原始紀錄來自協會 Facebook 專頁。各貼文的原始連結可由<a href="https://www.facebook.com/hkalhl.org" target="_blank" rel="noreferrer">官方專頁</a>瀏覽。</p></div></section>
</SiteLayout>
