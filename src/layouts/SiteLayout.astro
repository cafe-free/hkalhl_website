---
interface Props {
  title: string;
  description: string;
  active?: string;
}
const { title, description, active = "" } = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const navItems = [
  { label: "首頁", href: "/", id: "home" },
  { label: "關於本會", href: "/about/", id: "about" },
  { label: "核心項目", href: "/services/", id: "services" },
  { label: "最新動向", href: "/news/", id: "news" },
  { label: "活動回顧", href: "/gallery/", id: "gallery" },
  { label: "支持與參與", href: "/join/", id: "join" },
];
const schema = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: "香港愛馬女士協會",
  alternateName: "Hong Kong Association of Lady Horse Lovers",
  url: "https://hkalhl.org/",
  email: "ka20180801@gmail.com",
  sameAs: [
    "https://www.facebook.com/hkalhl.org",
    "https://www.instagram.com/hkalhl",
  ],
  foundingDate: "2017",
};
const colors = {
  navy: "#102b43",
  navy2: "#193b54",
  "navy-deep": "#102030",
  "navy-band": "#16364d",
  "navy-join": "#18374e",
  "navy-mid": "#183a51",
  "navy-slate": "#253a46",
  "navy-slate-alt": "#223a47",
  "navy-hover": "#274a61",
  "navy-hero-end": "#25445a",
  "navy-radial": "#315168",
  "navy-card": "#234864",
  ink: "#172b3c",
  "ink-dark": "#132b3c",
  "topline-yellow-start": "#f7f07c",
  "topline-yellow-end": "#e6d763",
  "footer-purple": "#17135f",
  "footer-indigo": "#222c83",
  "footer-teal": "#1c5d85",
  gold: "#c6a477",
  "gold-soft": "#c5a477",
  "gold-light": "#e1c8a4",
  "gold-pale": "#dec49f",
  "gold-sand": "#d8bc91",
  "gold-champagne": "#d9c09b",
  "gold-muted": "#d1b68f",
  "gold-cream": "#d5c5a9",
  "gold-mid": "#b69669",
  "gold-warm": "#b59569",
  "gold-ochre": "#b29367",
  "gold-tan": "#ae8d62",
  "gold-dark": "#a17f54",
  "gold-bronze": "#a1845c",
  "gold-umber": "#9b7a4f",
  "gold-taupe": "#9a8a74",
  white: "#fff",
  cream: "#f7f5f0",
  "bg-news": "#f8f7f4",
  "bg-card-soft": "#fbfaf7",
  "bg-photo": "#f3f2ef",
  "bg-placeholder": "#d7d5cf",
  "bg-gallery": "#d1d0ca",
  line: "#e5e2db",
  "line-warm": "#dedbd3",
  "line-timeline": "#ded9cf",
  "line-tag": "#e4e0d7",
  "line-filter": "#d9d7d0",
  "line-light": "#eee",
  muted: "#71808a",
  "muted-dark": "#52626d",
  "muted-slate": "#60727c",
  "muted-copy": "#65747c",
  "muted-intro": "#66747c",
  "muted-filter": "#67757c",
  "muted-detail": "#69777e",
  "muted-tag": "#6c787e",
  "muted-contact": "#6d7a81",
  "muted-card": "#73818a",
  "muted-join": "#738087",
  "muted-timeline": "#748189",
  "muted-album": "#748087",
  "muted-loading": "#75828a",
  "muted-news": "#78848a",
  "muted-num": "#7d898f",
  "muted-note": "#828d92",
  "muted-archive": "#869197",
  "muted-small": "#879197",
  "muted-count": "#8d989d",
  "muted-bottom": "#90a0a7",
  "muted-footnote": "#9fb0b7",
  "light-steel": "#aebdc2",
  "light-silver": "#b8c5ca",
  "light-sky": "#bdcbd0",
  "light-ice": "#c0cbd0",
  "light-mist": "#c2cdd1",
  "light-fog": "#c5d0d5",
  "light-quote": "#c7d1d5",
  "light-hero": "#cfdbdf",
  "light-stat": "#d5dfe2",
  "light-note": "#d8dfe1",
  "light-footer": "#d8e0e2",
  "light-topline": "#dce4e8",
  "light-copy": "#e0e5e7",
  "shadow-card": "#18314613",
  "shadow-badge": "#17354c30",
  "shadow-nav": "#112c4215",
  "shadow-modal": "#06111b55",
  "backdrop-modal": "#06111bcc",
  "backdrop-lightbox": "#06111be8",
  "overlay-gallery": "#132a3db0",
  "white-tint-03": "#ffffff08",
  "white-tint-14": "#ffffff24",
  "white-tint-18": "#ffffff2d",
};
const colorCss = `:root{${Object.entries(colors)
  .map(([k, v]) => `--${k}:${v}`)
  .join(";")}}`;
---

<!doctype html>
<html lang="zh-Hant-HK">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#102b43" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_HK" />
    <meta property="og:site_name" content="香港愛馬女士協會 HKALHL" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content="https://hkalhl.org/assets/logo.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" type="image/png" href="/assets/logo.png" />
    <link rel="preconnect" href="https://scontent-nrt6-1.xx.fbcdn.net" />
    <link rel="preconnect" href="https://font.emtech.cc" crossorigin />
    <style set:html={colorCss} />
    <link rel="stylesheet" href="/styles.css?v=11" />
    <title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body>
    <a class="skip-link" href="#main">
      跳至主要內容
    </a>
    <div class="topline">
      <div class="container topline-inner">
        <div>
          <a href="tel:+85298258855">☎　9825 8855</a>
          <a href="mailto:ka20180801@gmail.com">✉　ka20180801@gmail.com</a>
          <a
            href="https://www.facebook.com/hkalhl.org"
            target="_blank"
            rel="noreferrer"
          >
            Facebook ↗
          </a>
          <a
            href="https://www.instagram.com/hkalhl"
            target="_blank"
            rel="noreferrer"
          >
            Instagram ↗
          </a>
        </div>
      </div>
    </div>
    <header class="site-header">
      <div class="container nav-wrap">
        <a class="brand" href="/" aria-label="香港愛馬女士協會首頁">
          <img src="/assets/logo.png" alt="香港愛馬女士協會 HKALHL" />
        </a>
        <button class="menu-toggle" aria-label="開啟選單" aria-expanded="false">
          <span></span>
          <span></span>
        </button>
        <nav class="main-nav" aria-label="主選單">
          {navItems.map((item) => (
            <a
              class:list={[active === item.id && "active"]}
              href={item.href}
              aria-current={active === item.id ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
          <a class="nav-cta" href="#contact">
            聯絡我們 <span>↗</span>
          </a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer" id="contact">
      <div class="container footer-main">
        <div class="footer-brand">
          <img
            src="/assets/HKALHH_logo_newer_ver.webp"
            alt="香港愛馬女士協會"
          />
          <p>
            凝聚及發揮女性馬主與愛馬人士的力量，透過慈善活動服務社群及有需要人士。
          </p>
          <a
            href="https://www.facebook.com/hkalhl.org"
            target="_blank"
            rel="noreferrer"
            class="social-link"
          >
            f <span>追蹤 Facebook 專頁 ↗</span>
          </a>
          <a
            href="https://www.instagram.com/hkalhl"
            target="_blank"
            rel="noreferrer"
            class="social-link"
            style="margin-top:8px"
          >
            ◎ <span>追蹤 Instagram ↗</span>
          </a>
        </div>
        <div class="footer-col">
          <h4>快速連結</h4>
          <a href="/about/">關於本會</a>
          <a href="/services/">核心項目</a>
          <a href="/news/">最新動向</a>
          <a href="/gallery/">活動回顧</a>
        </div>
        <div class="footer-col">
          <h4>服務項目</h4>
          <a href="/services/#medical">專科義診醫療日</a>
          <a href="/services/#elderly">情暖銀齡</a>
          <a href="/services/#charity">慈善盛事</a>
          <a href="/join/">加入我們</a>
        </div>
        <div class="footer-col contact-col">
          <h4>聯絡我們</h4>
          <span>香港愛馬女士協會</span>
          <span>香港註冊慈善團體（編號：[placeholder]）</span>
          <a href="mailto:ka20180801@gmail.com">ka20180801@gmail.com</a>
          <span>服務諮詢請電郵聯絡</span>
          <a class="footer-contact" href="mailto:ka20180801@gmail.com">
            發送查詢 <b>↗</b>
          </a>
        </div>
      </div>
      <div class="container footer-bottom">
        <span>
          © 2017–{new Date().getFullYear()} Hong Kong Association of Lady Horse
          Lovers (HKALHL). All Rights Reserved.
        </span>
        <a href="#main">返回頁首 ↑</a>
      </div>
    </footer>
    <dialog class="lightbox" aria-label="活動照片">
      <button class="lightbox-close" aria-label="關閉">
        ×
      </button>
      <img alt="協會活動照片" />
      <p></p>
    </dialog>
    <dialog class="event-modal" aria-label="活動詳情">
      <button class="event-modal-close" aria-label="關閉">
        ×
      </button>
      <div class="event-modal-gallery"></div>
      <div class="event-modal-body">
        <div class="event-modal-meta">
          <span class="event-modal-tag"></span>
          <time></time>
        </div>
        <h3></h3>
        <div class="event-modal-content"></div>
      </div>
    </dialog>
    <script>
      const menuButton = document.querySelector(".menu-toggle");
      const menu = document.querySelector(".main-nav");
      menuButton?.addEventListener("click", () => {
        const open = menu.classList.toggle("open");
        menuButton.setAttribute("aria-expanded", String(open));
      });
      menu?.querySelectorAll("a").forEach((link) =>
        link.addEventListener("click", () => {
          menu.classList.remove("open");
          menuButton.setAttribute("aria-expanded", "false");
        }),
      );
      const dialog = document.querySelector(".lightbox");
      document
        .querySelector(".lightbox-close")
        ?.addEventListener("click", () => dialog.close());
      dialog?.addEventListener("click", (event) => {
        if (event.target === dialog) dialog.close();
      });
      const applyFilter = (filterKey) => {
        const targetButton = document.querySelector(
          `.filter[data-filter="${filterKey}"]`,
        );
        if (!targetButton) return;
        document.querySelector(".filter.active")?.classList.remove("active");
        targetButton.classList.add("active");
        document.querySelectorAll(".news-card").forEach((card) => {
          card.hidden =
            filterKey !== "all" && card.dataset.category !== filterKey;
        });
      };
      document.querySelectorAll(".filter").forEach((button) =>
        button.addEventListener("click", () => {
          applyFilter(button.dataset.filter || "all");
        }),
      );
      const initialFilter = new URLSearchParams(window.location.search).get(
        "filter",
      );
      if (initialFilter) applyFilter(initialFilter);
      document.querySelectorAll(".gallery-item").forEach((item) =>
        item.addEventListener("click", () => {
          dialog.querySelector("img").src = item.dataset.src;
          dialog.querySelector("img").alt = item.dataset.alt;
          dialog.querySelector("p").textContent = item.dataset.alt;
          dialog.showModal();
        }),
      );
      const eventModal = document.querySelector(".event-modal");
      const openEventModal = (card) => {
        if (!eventModal) return;
        const gallery = eventModal.querySelector(".event-modal-gallery");
        const tag = eventModal.querySelector(".event-modal-tag");
        const time = eventModal.querySelector("time");
        const heading = eventModal.querySelector("h3");
        const body = eventModal.querySelector(".event-modal-content");
        const title = card.dataset.title || "";
        const content = card.dataset.content || "";
        let images = [];
        try {
          images = JSON.parse(card.dataset.images || "[]");
        } catch {
          images = [];
        }
        if (!images.length && card.dataset.image) images = [card.dataset.image];
        const visibleImages = images.slice(0, 5);
        gallery.innerHTML = "";
        if (visibleImages.length) {
          gallery.hidden = false;
          gallery.dataset.count = String(visibleImages.length);
          visibleImages.forEach((src, index) => {
            const img = document.createElement("img");
            img.src = src;
            img.alt = `${title || "活動照片"} (${index + 1})`;
            img.loading = "lazy";
            img.addEventListener("click", () => {
              if (!dialog) return;
              dialog.querySelector("img").src = src;
              dialog.querySelector("img").alt = title || "協會活動照片";
              dialog.querySelector("p").textContent = title;
              dialog.showModal();
            });
            gallery.appendChild(img);
          });
        } else {
          gallery.hidden = true;
          gallery.dataset.count = "0";
        }
        tag.textContent = card.dataset.categoryLabel || "";
        time.textContent = card.dataset.date || "";
        heading.textContent = title;
        body.innerHTML = "";
        content
          .split("\n")
          .filter(Boolean)
          .forEach((line) => {
            const p = document.createElement("p");
            p.textContent = line;
            body.appendChild(p);
          });
        eventModal.showModal();
      };
      document.querySelectorAll(".news-card").forEach((card) => {
        card.addEventListener("click", () => openEventModal(card));
        card.addEventListener("keydown", (event) => {
          if (event.key === "Enter" || event.key === " ") {
            event.preventDefault();
            openEventModal(card);
          }
        });
      });
      document
        .querySelector(".event-modal-close")
        ?.addEventListener("click", () => eventModal?.close());
      eventModal?.addEventListener("click", (event) => {
        if (event.target === eventModal) eventModal.close();
      });
    </script>
  </body>
</html>
